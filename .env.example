# Database Connection for Prisma (SQLite or PostgreSQL)
# For SQLite local dev: "file:../data/discode.db"
# For PostgreSQL in Production (e.g. Supabase, Neon, Vercel Postgres):
DATABASE_URL="postgresql://user:password@ep-sample-host.neon.tech/neondb?sslmode=require"

# Base Application URL (Set this to your Vercel deployment domain e.g. https://structui.vercel.app)
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# JWT Session Secret (Use a strong random string)
JWT_SECRET="your_super_secret_jwt_key_structui_2026"

# SMTP Configuration for Email Verification (Gmail / Resend / SendGrid)
SMTP_HOST="smtp.gmail.com"
SMTP_PORT=587
SMTP_USER="your-email@gmail.com"
SMTP_PASS="your-app-password"
SMTP_FROM="structui <no-reply@structui.dev>"

# Discord OAuth2 Configuration (From https://discord.com/developers/applications)
DISCORD_CLIENT_ID=""
DISCORD_CLIENT_SECRET=""
DISCORD_REDIRECT_URI="http://localhost:3000/api/auth/discord/callback"

# Discord Bot & Guild Integration
DISCORD_BOT_TOKEN=""
DISCORD_GUILD_ID="1539313350863749171"
DISCORD_INVITE_URL="https://discord.gg/MdQqack6Jb"
